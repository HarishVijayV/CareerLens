# Development image: runs `next dev` with hot reload, so editing a file on the host
# updates the browser without a rebuild.
#
# Separate from the production Dockerfile on purpose — that one runs `next build` and
# bakes the output in, which is right for shipping and wrong for development (every edit
# would mean rebuilding the image).
FROM node:20-alpine

WORKDIR /app

# Copy manifests first so `npm ci` is cached and only re-runs when dependencies actually
# change — not on every source edit.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

# Two flags, both load-bearing in a container:
#
# -H 0.0.0.0   Next binds to localhost by default, which inside a container means the
#              container's OWN loopback — the port mapping then appears to do nothing.
#
# --webpack    Turbopack (the Next 16 default) relies on native filesystem events, and
#              those don't cross a Windows/macOS Docker bind mount. Edits landed in the
#              container but never triggered a recompile, so the page silently served
#              stale content until a manual restart — the worst kind of "broken", because
#              nothing errors. Webpack honours WATCHPACK_POLLING (set in compose), which
#              polls instead of waiting for events. Slower to compile, but hot reload
#              actually works, which matters far more in development.
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "--webpack"]
